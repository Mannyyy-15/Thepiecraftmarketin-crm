# MySQL URL (TLS certificate verification is enabled in production)
DATABASE_URL="mysql://username:password@database-host:3306/database_name"
DB_ALLOW_INSECURE_TLS="false"

# Master Admin Credentials (automatic seed target)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-16-characters"

# JWT secret key for encrypting and signing session tokens
# Generate a strong 32-byte secret key (e.g. openssl rand -base64 32)
JWT_SECRET=""

# MFA secret encryption and recovery-code hashing
# MFA_ENCRYPTION_KEY: `openssl rand -base64 32`
MFA_ENCRYPTION_KEY=""
MFA_RECOVERY_PEPPER=""
SESSION_METADATA_PEPPER=""
INTEGRATION_ENCRYPTION_KEY=""

# OAuth application credentials used to refresh connector tokens server-side
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""

# Shared, distributed rate limiting. Required in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel Marketplace's Upstash integration supplies equivalent
# KV_REST_API_URL and KV_REST_API_TOKEN variables automatically.
RATE_LIMIT_KEY_SALT=""

# Private S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.)
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="false"

# Malware scanning HTTP service. Production uploads fail closed without it.
FILE_SCANNER_URL=""
FILE_SCANNER_TOKEN=""

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Automated Follow-Ups (Cron Security)
# Generate a random secret for Vercel Cron or GitHub Actions (e.g. openssl rand -hex 32)
CRON_SECRET=""

# Email Configuration (Nodemailer / Hostinger / SendGrid)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="hello@youragency.com"
SMTP_PASS="your-password"
SMTP_FROM="Your Agency <hello@youragency.com>"

# Public lead intake: comma-separated exact origins plus a shared secret header
LEADS_ALLOWED_ORIGINS="https://www.example.com"
LEADS_SUBMIT_TOKEN=""
LEADS_ORGANIZATION_SLUG="thepiecraft"

# Google/Firebase service-account JSON. Do not store the JSON file in the repo.
FIREBASE_SERVICE_ACCOUNT=""
LEADS_SHEET_ID=""

# Optional integrations
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
UPTIMEROBOT_API_KEY=""

# Capacitor must point only to a trusted HTTPS deployment.
CAP_SERVER_URL="https://crm.example.com"
